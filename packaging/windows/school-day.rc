#include <windows.h>
#include "school-day-version.h"
1 ICON "packaging/windows/school-day.ico"
1 RT_MANIFEST "packaging/windows/school-day.manifest"
1 VERSIONINFO
FILEVERSION APP_VERSION_NUM
PRODUCTVERSION APP_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "sqeezy-53\0"
      VALUE "FileDescription", "Школьный день\0"
      VALUE "FileVersion", APP_VERSION_TEXT
      VALUE "InternalName", "school-day\0"
      VALUE "OriginalFilename", "school-day.exe\0"
      VALUE "ProductName", "Школьный день\0"
      VALUE "ProductVersion", APP_VERSION_TEXT
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
